SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RAW_VIDEOS_BUCKET=raw-videos
AUDIO_BUCKET=audio
TRANSCRIPTS_BUCKET=transcripts
ANALYSIS_BUCKET=transcripts
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=whisper-1
FRAME_SAMPLE_RATE=1
KEYFRAME_SCENE_THRESHOLD=0.35
MAX_KEYFRAMES_TO_ANALYZE=3
ENABLE_KEYFRAME_OCR=true
TESSERACT_LANGUAGE=eng
TESSERACT_MIN_CONFIDENCE=35
TESSERACT_INIT_TIMEOUT_MS=15000
TESSERACT_RECOGNITION_TIMEOUT_MS=8000
ENABLE_KEYFRAME_VISION=true
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_TIMEOUT_MS=8000
